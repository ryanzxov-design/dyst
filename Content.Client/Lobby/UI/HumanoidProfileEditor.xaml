<BoxContainer xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:humanoid="clr-namespace:Content.Client.Humanoid"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
         xmlns:ui="clr-namespace:Content.Client.Lobby.UI"
         xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
         xmlns:term="clr-namespace:Content.Client._Dystopia.Lobby"
         HorizontalExpand="True"
         SeparationOverride="22">
        <!-- Dystopia: раскладка «А. Картотека» — в центре вкладки дела (имя и случайные параметры переехали во вкладку
             внешности), справа предпросмотр (поворот, одежда) и сохранение. У вкладок с текстом прокрутки вбок нет:
             иначе длинное предупреждение об именах растягивает вкладку и поля справа уезжают за край. -->
        <!-- Центр: вкладки дела -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <!-- tabContainer -->
            <TabContainer Name="TabContainer" VerticalExpand="True">
                <BoxContainer Orientation="Vertical">
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <!-- appearanceList -->
                        <BoxContainer Orientation="Vertical">
                            <!-- Имя -->
                            <BoxContainer Margin="10 10 10 0" Orientation="Vertical" HorizontalExpand="True">
                                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-name-label'}" />
                                    <LineEdit Name="NameEdit" MinSize="270 0" HorizontalExpand="True" VerticalAlignment="Center" Margin="10 0 0 0" />
                                </BoxContainer>
                                <RichTextLabel Name="WarningLabel" HorizontalExpand="True" />
                            </BoxContainer>
                            <BoxContainer Margin="10" Orientation="Vertical" HorizontalExpand="True">
                                <!-- Species -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-species-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <TextureButton Name="SpeciesInfoButton" Scale="0.3 0.3"
                                                   VerticalAlignment="Center"
                                                   ToolTip="{Loc 'humanoid-profile-editor-guidebook-button-tooltip'}"/>
                                    <OptionButton Name="SpeciesButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Age -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-age-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <LineEdit Name="AgeEdit" MinSize="60 0" HorizontalAlignment="Right" /> <!-- Corvax-SpeciesAgeLore -->
                                </BoxContainer>
                                <!-- Sex -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-sex-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="SexButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Voice -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-voice-label'}" />
                                    <Control HorizontalExpand="True" />
                                    <OptionButton Name="VoiceButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Pronouns -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-pronouns-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="PronounsButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                                <!-- Spawn Priority -->
                                <BoxContainer HorizontalExpand="True">
                                    <Label Text="{Loc 'humanoid-profile-editor-spawn-priority-label'}" />
                                    <Control HorizontalExpand="True"/>
                                    <OptionButton Name="SpawnPriorityButton" HorizontalAlignment="Right" />
                                </BoxContainer>
                            </BoxContainer>
                            <!-- Skin -->
                            <BoxContainer Margin="10" HorizontalExpand="True" Orientation="Vertical">
                                <Label Text="{Loc 'humanoid-profile-editor-skin-color-label'}" />
                                <Slider HorizontalExpand="True" Name="Skin" MinValue="0" MaxValue="100" Value="20" />
                                <BoxContainer Name="RgbSkinColorContainer" Visible="False" Orientation="Vertical" HorizontalExpand="True"></BoxContainer>
                            </BoxContainer>
                            <!-- Eyes -->
                            <BoxContainer Margin="10" Orientation="Vertical">
                                <Label Text="{Loc 'humanoid-profile-editor-eyes-label'}" />
                                <humanoid:EyeColorPicker Name="EyeColorPicker" />
                            </BoxContainer>
                            <!-- Случайное при входе -->
                            <BoxContainer Margin="10" Orientation="Vertical" SeparationOverride="6">
                                <Label Text="{Loc 'humanoid-profile-editor-randomize'}" />
                                <GridContainer Columns="4" HorizontalExpand="True">
                                    <ui:RandomizeLockButton For="Name" LabelText="{Loc 'humanoid-profile-editor-randomize-name-button'}"/>
                                    <ui:RandomizeLockButton For="Species" LabelText="{Loc 'humanoid-profile-editor-randomize-species-button'}"/>
                                    <ui:RandomizeLockButton For="Age" LabelText="{Loc 'humanoid-profile-editor-randomize-age-button'}"/>
                                    <ui:RandomizeLockButton For="Sex" LabelText="{Loc 'humanoid-profile-editor-randomize-sex-button'}"/>
                                    <ui:RandomizeLockButton For="Skin" LabelText="{Loc 'humanoid-profile-editor-randomize-skin-button'}"/>
                                    <ui:RandomizeLockButton For="Eyes" LabelText="{Loc 'humanoid-profile-editor-randomize-eye-button'}"/>
                                    <ui:RandomizeLockButton For="Markings" LabelText="{Loc 'humanoid-profile-editor-randomize-markings-button'}"/>
                                </GridContainer>
                                <Button Name="RandomizeUnlockedButton"
                                        HorizontalAlignment="Left"
                                        Text="{Loc 'humanoid-profile-editor-randomize-unlocked-button'}"/>
                            </BoxContainer>
                        </BoxContainer>
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical">
                    <!-- Jobs -->
                    <OptionButton Name="PreferenceUnavailableButton" />
                    <ScrollContainer VerticalExpand="True">
                        <BoxContainer Name="JobList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- Antags -->
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="AntagList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" Margin="10">
                    <!-- Traits -->
                    <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                        <BoxContainer Name="TraitsList" Orientation="Vertical" />
                    </ScrollContainer>
                </BoxContainer>
                <BoxContainer Name="MarkingsTab" Orientation="Vertical" Margin="10">
                    <!-- Markings -->
                    <humanoid:MarkingPicker Name="Markings" HorizontalExpand="True" VerticalExpand="True" />
                </BoxContainer>
            </TabContainer>
        </BoxContainer>
        <!-- Справа: предпросмотр и сохранение -->
        <BoxContainer Orientation="Vertical" MinWidth="300" MaxWidth="300" SeparationOverride="12">
            <term:DystopiaTerminalFrame TitleKey="setup-preview" PadTop="26" PadLeft="14" PadRight="14">
                <BoxContainer Orientation="Vertical" SeparationOverride="8">
                    <term:DystopiaPortraitFrame MinSize="270 310">
                        <profile:ProfilePreviewSpriteView Name="SpriteView" Scale="8 8"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <term:DystopiaPortraitScan />
                    </term:DystopiaPortraitFrame>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                        <Button Name="SpriteRotateLeft" Text="◄" />
                        <Button Name="ShowClothes" Pressed="True" ToggleMode="True" HorizontalExpand="True"
                                Text="{Loc 'humanoid-profile-editor-clothing-show'}" />
                        <Button Name="SpriteRotateRight" Text="►" />
                    </BoxContainer>
                </BoxContainer>
            </term:DystopiaTerminalFrame>
            <Control VerticalExpand="True" />
            <BoxContainer Orientation="Vertical" SeparationOverride="6">
                <Button Name="SaveButton" MinHeight="44" Text="{Loc 'humanoid-profile-editor-save-button'}"/>
                <GridContainer Columns="2" HorizontalExpand="True">
                    <Button Name="ResetButton" Disabled="True" HorizontalExpand="True" Text="{Loc 'humanoid-profile-editor-reset-button'}"/>
                    <Button Name="ExportImageButton" HorizontalExpand="True" Text="{Loc 'humanoid-profile-editor-export-image-button'}"/>
                    <Button Name="ImportButton" HorizontalExpand="True" Text="{Loc 'humanoid-profile-editor-import-button'}"/>
                    <Button Name="ExportButton" HorizontalExpand="True" Text="{Loc 'humanoid-profile-editor-export-button'}"/>
                </GridContainer>
                <Button Name="OpenImagesButton" Text="{Loc 'humanoid-profile-editor-open-image-button'}"/>
            </BoxContainer>
        </BoxContainer>
</BoxContainer>
