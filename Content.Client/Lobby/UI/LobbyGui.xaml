<!-- Dystopia: лобби — терминал Городской сети (Content.Client/_Dystopia/Lobby). Ванильные элементы лобби остались
     под своими именами (их трогают LobbyState, LobbyUIController, AHelpUIController), но кнопки спрятаны внутрь
     терминальных обёрток, а надписи и рамки рисует терминал. Раскладка «досье в центре»: слева силуэт и сводка, в центре
     личное дело и большая кнопка готовности, справа чат. Тема (цвет и тексты) — по должности на высоком приоритете. -->
<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:term="clr-namespace:Content.Client._Dystopia.Lobby"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets">
    <!-- Фон ванильного лобби: виден только в настройке персонажа -->
    <TextureRect Access="Public" VerticalExpand="True" HorizontalExpand="True" Name="Background"
                 Stretch="KeepAspectCovered" Visible="False" />

    <term:DystopiaTerminalScreen Name="DefaultState" Access="Public">
        <BoxContainer Orientation="Vertical">
            <BoxContainer Name="MainContainer" Orientation="Vertical" Margin="44 30 44 0" SeparationOverride="10"
                          VerticalExpand="True">
                <!-- Шапка -->
                <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Horizontal" SeparationOverride="24">
                    <term:DystopiaTermLabel TextKey="head" FontSize="15" Spacing="2" />
                    <term:DystopiaTermLabel Name="HeadServer" FontSize="15" Spacing="2" Tone="Dim" />
                    <Control HorizontalExpand="True" />
                    <term:DystopiaTermLabel Name="HeadClock" FontSize="15" Spacing="2" Tone="Dim" />
                    <term:DystopiaTermLabel TextKey="link" FontSize="15" Spacing="2" Pulse="True" />
                    <!-- ванильные надписи: их заполняет LobbyState, шапка берёт оттуда имя сервера -->
                    <Label Name="ServerName" Access="Public" Visible="False" />
                    <Label Name="StationTime" Access="Public" Visible="False" />
                    <Label Name="StartTime" Access="Public" Visible="False" />
                </BoxContainer>
                <term:DystopiaDashedLine />

                <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="24">
                    <!-- Слева: силуэт Города, журнал узла, сводка смены и голосования, ссылки -->
                    <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="14" MinWidth="420" MaxWidth="420">
                        <term:DystopiaLobbyHero Unit="3" CaptionSize="18" Slogans="False" />
                        <term:DystopiaTerminalFrame TitleKey="boot" PadTop="24" PadBottom="10">
                            <term:DystopiaBootLog />
                        </term:DystopiaTerminalFrame>
                        <term:DystopiaTerminalFrame TitleKey="info">
                            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                                <!-- ванильная сводка: текст ей даёт LobbyState, рисует его терминал -->
                                <info:ServerInfo Name="ServerInfo" Access="Public" Visible="False" />
                                <term:DystopiaLobbyInfo />
                                <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer" Access="Public" />
                            </BoxContainer>
                        </term:DystopiaTerminalFrame>
                        <Control VerticalExpand="True" />
                        <term:DystopiaTerminalFrame TitleKey="links">
                            <term:DystopiaLobbyLinks />
                        </term:DystopiaTerminalFrame>
                    </BoxContainer>

                    <!-- В центре: личное дело (одна кнопка настройки), большая кнопка готовности с отсчётом, ряд команд -->
                    <BoxContainer Name="CenterSide" Orientation="Vertical" SeparationOverride="12" HorizontalExpand="True">
                        <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" VerticalExpand="True" />
                        <term:DystopiaLobbyReadyPanel>
                            <Button Name="ReadyButton" Access="Public" ToggleMode="True" />
                        </term:DystopiaLobbyReadyPanel>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                            <term:DystopiaTerminalSlot Role="observe">
                                <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                    WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                            </term:DystopiaTerminalSlot>
                            <term:DystopiaTerminalSlot Role="vote">
                                <vote:VoteCallMenuButton Name="CallVoteButton" />
                            </term:DystopiaTerminalSlot>
                            <term:DystopiaTerminalSlot Role="options">
                                <Button Name="OptionsButton" Access="Public" />
                            </term:DystopiaTerminalSlot>
                            <term:DystopiaTerminalSlot Role="ahelp">
                                <Button Name="AHelpButton" Access="Public" />
                            </term:DystopiaTerminalSlot>
                            <term:DystopiaTerminalSlot Role="leave">
                                <Button Name="LeaveButton" Access="Public" />
                            </term:DystopiaTerminalSlot>
                        </BoxContainer>
                        <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" />
                    </BoxContainer>

                    <!-- Справа: общий канал во всю высоту -->
                    <BoxContainer Name="RightSide" Access="Public" Orientation="Vertical" MinWidth="420" MaxWidth="420">
                        <term:DystopiaTerminalFrame TitleKey="chat" VerticalExpand="True">
                            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                                <!-- у ChatBox своя наименьшая ширина 465 — шире колонки; её сбрасывает LobbyGui.xaml.cs -->
                                <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" />
                                <!-- вкладки каналов вместо ванильного переключателя -->
                                <term:DystopiaChatChannels Name="ChatChannels" />
                            </BoxContainer>
                        </term:DystopiaTerminalFrame>
                    </BoxContainer>
                </BoxContainer>
                <!-- ванильные надписи о музыке и фоне: в терминале не показываются -->
                <RichTextLabel Name="LobbySong" Access="Public" Visible="False" />
                <RichTextLabel Name="LobbyBackground" Access="Public" Visible="False" />
            </BoxContainer>
            <!-- над корпусом кинескопа (кромка 12 точек снизу), иначе строку срезает -->
            <term:DystopiaLobbyTicker Margin="0 10 0 14" />
        </BoxContainer>
        <!-- эффекты кинескопа поверх всего -->
        <term:DystopiaCrtOverlay />
    </term:DystopiaTerminalScreen>

    <!-- Настройка персонажа (вставляет LobbyUIController) -->
    <Control Access="Public" Visible="False" Name="CharacterSetupState" />
</lobbyUi:LobbyGui>
