<!-- Dystopia: настройка персонажа — терминал «Реестр граждан» (раскладка «А. Картотека»): шапка с командами, слева
     картотека дел (персонажи), справа редактор дела (HumanoidProfileEditor: вкладки + предпросмотр и сохранение).
     Ванильные кнопки и поля выглядят терминалом, пока открыт этот экран (DystopiaTerminalStylesheet). -->
<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
         xmlns:term="clr-namespace:Content.Client._Dystopia.Lobby"
         VerticalExpand="True">
    <term:DystopiaTerminalScreen>
        <BoxContainer Orientation="Vertical" Margin="44 30 44 26" SeparationOverride="12">
            <!-- Шапка -->
            <BoxContainer Orientation="Horizontal" SeparationOverride="18">
                <term:DystopiaTermLabel TextKey="setup-head" FontSize="15" Spacing="2" VerticalAlignment="Center" />
                <term:DystopiaTermLabel TextKey="subtitle" FontSize="15" Spacing="2" Tone="Dim" VerticalAlignment="Center" />
                <Control HorizontalExpand="True" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                    <Button Name="StatsButton" Text="{Loc 'character-setup-gui-character-setup-stats-button'}" />
                    <cc:CommandButton Name="AdminRemarksButton"
                                      Command="adminremarks"
                                      Text="{Loc 'character-setup-gui-character-setup-adminremarks-button'}" />
                    <!-- Corvax-Sponsor-Start -->
                    <Button Name="SponsorButton"
                            Text="{Loc 'character-setup-gui-character-setup-sponsor-button'}"
                            Visible="False" />
                    <!-- Corvax-Sponsor-End -->
                    <Button Name="RulesButton" Text="{Loc 'character-setup-gui-character-setup-rules-button'}" />
                    <Button Name="CloseButton" Access="Public" Text="{Loc 'dystopia-lobby-setup-close'}" />
                </BoxContainer>
            </BoxContainer>
            <term:DystopiaDashedLine />

            <BoxContainer Orientation="Horizontal" VerticalExpand="True" SeparationOverride="22">
                <!-- Картотека: персонажи -->
                <term:DystopiaTerminalFrame TitleKey="setup-files" MinWidth="320" MaxWidth="320" PadLeft="10" PadRight="10">
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                        <BoxContainer Name="Characters" Orientation="Vertical" SeparationOverride="6" />
                    </ScrollContainer>
                </term:DystopiaTerminalFrame>
                <!-- Редактор дела -->
                <BoxContainer Name="CharEditor" HorizontalExpand="True" />
            </BoxContainer>
        </BoxContainer>
        <!-- эффекты кинескопа поверх всего -->
        <term:DystopiaCrtOverlay />
    </term:DystopiaTerminalScreen>
</Control>
