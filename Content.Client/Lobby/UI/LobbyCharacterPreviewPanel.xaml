<!-- Dystopia: «личное дело» лобби-терминала — спрайт персонажа в рамке-видоискателе, поля дела по теме, распределение
     по должностям и одна кнопка настройки персонажа (там же выбор другого персонажа и приоритеты). -->
<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:term="clr-namespace:Content.Client._Dystopia.Lobby"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls">
    <term:DystopiaTerminalFrame Name="VBox" TitleKey="dossier" PadTop="28" PadLeft="20" PadRight="20" PadBottom="16">
        <BoxContainer Orientation="Vertical">
            <BoxContainer Name="Loaded" Orientation="Vertical" SeparationOverride="14" Visible="False" VerticalExpand="True">
                <BoxContainer Orientation="Horizontal" SeparationOverride="24">
                    <term:DystopiaPortraitFrame MinSize="200 250">
                        <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                          OverrideDirection="South"
                                                          Scale="5 5"
                                                          MaxSize="160 160"
                                                          Stretch="Fill"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Access="Public" />
                        <term:DystopiaPortraitScan />
                    </term:DystopiaPortraitFrame>
                    <term:DystopiaLobbyDossierFields />
                </BoxContainer>
                <term:DystopiaTermLabel TextKey="jobs" FontSize="13" Spacing="2" Tone="Dim" />
                <term:DystopiaLobbyJobs />
                <Label Name="Summary" Visible="False" />
                <Control VerticalExpand="True" />
                <term:DystopiaTerminalButton Name="CharacterSetup" TextKey="edit" HorizontalExpand="True" />
            </BoxContainer>
            <term:DystopiaTermLabel Name="Unloaded" TextKey="unloaded" Tone="Dim" />
        </BoxContainer>
    </term:DystopiaTerminalFrame>
</Control>
