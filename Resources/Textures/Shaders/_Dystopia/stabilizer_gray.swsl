// Dystopia: у работающего стабилизатора мир сереет — Сеть высасывает из мира краски.
uniform sampler2D SCREEN_TEXTURE;
uniform highp float amount; // 0 — как обычно, 1 — полностью серый

void fragment() {
    highp vec4 src = zTextureSpec(SCREEN_TEXTURE, UV);
    highp float lum = zGrayscale(src.rgb);
    highp vec3 gray = vec3(lum) * vec3(0.97, 1.0, 1.03);
    COLOR = vec4(mix(src.rgb, gray, clamp(amount, 0.0, 1.0)), src.a);
}
