// Dystopia: у работающего стабилизатора мир сереет, а совсем рядом — идёт зерном и помехами.
uniform sampler2D SCREEN_TEXTURE;
uniform highp float amount; // серость: 0 — как обычно, 1 — полностью серый
uniform highp float noise;  // зерно и помехи: 0 — нет, 1 — максимум

void fragment() {
    highp vec2 uv = UV;

    // Помехи: отдельные горизонтальные полосы экрана «съезжают» вбок
    if (noise > 0.0) {
        highp float band = floor(uv.y * 90.0);
        highp float roll = zRandom(vec2(band, floor(TIME * 18.0))).x;
        if (roll > 1.0 - noise * 0.35) {
            uv.x += (zRandom(vec2(band, TIME)).x - 0.5) * 0.025 * noise;
        }
    }

    highp vec4 src = zTextureSpec(SCREEN_TEXTURE, uv);
    highp float lum = zGrayscale(src.rgb);
    highp vec3 gray = vec3(lum) * vec3(0.97, 1.0, 1.03);
    highp vec3 c = mix(src.rgb, gray, clamp(amount, 0.0, 1.0));

    if (noise > 0.0) {
        // Зерно
        highp float grain = zRandom(uv * 613.0 + vec2(TIME * 3.1, TIME * 1.7)).x - 0.5;
        c += vec3(grain * 0.32 * noise);

        // Редкие светлые полосы-разрывы
        highp float tear = step(0.996 - noise * 0.02, zRandom(vec2(floor(uv.y * 300.0), floor(TIME * 30.0))).x);
        c = mix(c, vec3(lum + 0.25), tear * 0.55 * noise);
    }

    COLOR = vec4(clamp(c, 0.0, 1.0), src.a);
}
