# Dystopia: детали машин.

stack-dystopia-gear = чугунная шестерня
ent-DystopiaGear = чугунная шестерня
    .desc = Литая шестерня, зубья ещё шершавые после формы. Две таких и корпус — уже редуктор.
    .suffix = полный
ent-DystopiaGear1 = чугунная шестерня
    .desc = Литая шестерня, зубья ещё шершавые после формы. Две таких и корпус — уже редуктор.
    .suffix = один
stack-dystopia-winding = обмоточный провод
ent-DystopiaWinding = обмоточный провод
    .desc = Медная проволока в тканевой оплётке, пропитанной лаком. Из неё мотают катушки моторов.
    .suffix = полный
ent-DystopiaWinding1 = обмоточный провод
    .desc = Медная проволока в тканевой оплётке, пропитанной лаком. Из неё мотают катушки моторов.
    .suffix = один
stack-dystopia-packing = сальниковая набивка
ent-DystopiaPacking = сальниковая набивка
    .desc = Пеньковый шнур, пропитанный смолой. Им набивают сальники насосов, чтобы не текло по валу.
    .suffix = полный
ent-DystopiaPacking1 = сальниковая набивка
    .desc = Пеньковый шнур, пропитанный смолой. Им набивают сальники насосов, чтобы не текло по валу.
    .suffix = один
ent-DystopiaElectricMotor = электромотор
    .desc = Чугунный корпус, медные катушки внутри, вал с шестерёнкой наружу. Сердце любой машины, что работает от сети.
ent-DystopiaGearbox = редуктор
    .desc = Тяжёлый ребристый корпус с шестернями в масле. Мотор крутит быстро, а редуктор — сильно.
ent-DystopiaMouldGear = изложница на шестерню
    .desc = Чугунная изложница с зубчатой полостью, одна шестерня за налив. Льют в неё чугун, другой металл выйдет браком.
dystopia-mould-shape-gear = шестерня
