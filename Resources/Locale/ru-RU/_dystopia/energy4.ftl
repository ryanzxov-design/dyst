# Dystopia: энергетика, шаг 4 — нефтепровод, ЛЭП, трансформаторы (gen_energy4.py).

ent-DystopiaPipelineTerminal = терминал нефтепровода
    .desc = Конец закопанной магистральной трубы. Два терминала связывают стопкой секций трубы: тычок в один, потом в другой — труба ляжет по прямой между ними, до 80 клеток, секция на каждые 4 клетки. К обычным жидкостным трубам подключают экспортером или импортером. В меню один конец отправляет, другой принимает; насос на токе.
ent-DystopiaPipelineMarker = колодец нефтепровода
    .desc = Люк над закопанной магистральной трубой. Повреждён — труба под ним течёт; разбит — трубу рвёт. Чинят сваркой.
ent-DystopiaPipelineSection = секция магистральной трубы
    .desc = Отрезок толстой трубы для закопанного нефтепровода. Ткните стопкой в один терминал, потом в другой — труба ляжет между ними, секция на каждые 4 клетки.
    .suffix = Полный
ent-DystopiaPipelineSection10 = секция магистральной трубы
    .desc = Отрезок толстой трубы для закопанного нефтепровода. Ткните стопкой в один терминал, потом в другой — труба ляжет между ними, секция на каждые 4 клетки.
    .suffix = 10
ent-DystopiaPipelineSection1 = секция магистральной трубы
    .desc = Отрезок толстой трубы для закопанного нефтепровода. Ткните стопкой в один терминал, потом в другой — труба ляжет между ними, секция на каждые 4 клетки.
    .suffix = 1
stack-dystopia-pipeline-section = секции магистральной трубы
stack-dystopia-pylon-wire = провод ЛЭП
ent-DystopiaPylon = опора ЛЭП
    .desc = Стальная решётчатая опора воздушной линии. Провод вешают мотком провода ЛЭП: тычок в одну опору, потом в другую, до 12 клеток между ними. Опоры, связанные проводом, — одна высоковольтная сеть; к ней подключаются высоковольтным кабелем под любой опорой. Кусачки снимают провода опоры.
ent-DystopiaPylonWire = моток провода ЛЭП
    .desc = Голый сталеалюминиевый провод для воздушной линии. Ткните в одну опору, потом в другую: отрезок на каждую клетку пролёта.
    .suffix = Полный
ent-DystopiaPylonWire10 = моток провода ЛЭП
    .desc = Голый сталеалюминиевый провод для воздушной линии. Ткните в одну опору, потом в другую: отрезок на каждую клетку пролёта.
    .suffix = 10
ent-DystopiaPylonWire1 = моток провода ЛЭП
    .desc = Голый сталеалюминиевый провод для воздушной линии. Ткните в одну опору, потом в другую: отрезок на каждую клетку пролёта.
    .suffix = 1
ent-DystopiaTransformerLvMv = трансформаторная будка
    .desc = Повышающий трансформатор: низкое напряжение на входе, среднее на выходе, до 30 кВт, 5% теряется. Для переносных генераторов. Низковольтный кабель под ним — вход, средневольтный — выход.
ent-DystopiaTransformerMvHv = повышающая подстанция
    .desc = Повышающий трансформатор: среднее напряжение на входе, высокое на выходе, до 500 кВт, 5% теряется. Для дизель-генератора и для ЛЭП. Средневольтный кабель под ним — вход, высоковольтный — выход.
