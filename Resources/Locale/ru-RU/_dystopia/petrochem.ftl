# Dystopia: нефть, шаг 3 — нефтехимия. Генератор gen_petrochem.py.

reagent-name-dystopia-ethylene = этилен
reagent-desc-dystopia-ethylene = Сжиженный под давлением газ с крекинга, сладковато пахнет. Из него полимеризуют пластик. На воздухе мгновенно испаряется и вспыхивает.
reagent-name-dystopia-propylene = пропилен
reagent-desc-dystopia-propylene = Сжиженный газ с крекинга, чуть тяжелее этилена. Тоже идёт на пластик.
reagent-name-dystopia-butadiene = бутадиен
reagent-desc-dystopia-butadiene = Сжиженный газ с резким запахом бензина. Полимеризуется в синтетический каучук. Его делают крекингом нефти или из спирта по Лебедеву.
reagent-name-dystopia-latex = млечный сок
reagent-desc-dystopia-latex = Белый клейкий сок из корней кок-сагыза. Если свернуть кислотой, выпадает натуральный каучук.
materials-dystopia-carbon-black = сажа
stack-dystopia-carbon-black = сажа
ent-DystopiaCarbonBlack = сажа
    .desc = Чёрный жирный порошок, мажется от одного взгляда. Её подмешивают в резину, чтобы та не истиралась.
    .suffix = Сажа, полный
ent-DystopiaCarbonBlack1 = сажа
    .desc = Чёрный жирный порошок, мажется от одного взгляда. Её подмешивают в резину, чтобы та не истиралась.
    .suffix = Сажа, один
materials-dystopia-caoutchouc = каучук
stack-dystopia-caoutchouc = каучук
ent-DystopiaCaoutchouc = каучук
    .desc = Янтарные упругие комья сырого каучука. Липнут к рукам, на жаре текут, на морозе дубеют. С серой и сажей вулканизуется в резину.
    .suffix = Резина, полный
ent-DystopiaCaoutchouc1 = каучук
    .desc = Янтарные упругие комья сырого каучука. Липнут к рукам, на жаре текут, на морозе дубеют. С серой и сажей вулканизуется в резину.
    .suffix = Резина, один
materials-dystopia-rubber = резина
stack-dystopia-rubber = резина
ent-DystopiaSheetRubber = резина
    .desc = Листы вулканизированной резины: тянутся, не рвутся и не пропускают ни воду, ни ток.
    .suffix = Резина, полный
ent-DystopiaSheetRubber1 = резина
    .desc = Листы вулканизированной резины: тянутся, не рвутся и не пропускают ни воду, ни ток.
    .suffix = Резина, один
seeds-dystopia-kok-saghyz-name = кок-сагыз
ent-DystopiaKokSaghyzPlant = кок-сагыз
    .desc = { "" }
ent-DystopiaKokSaghyzSeeds = пакет семян кок-сагыза
    .desc = Семена каучуконосного одуванчика. Из млечного сока его корней получают натуральный каучук.
ent-DystopiaKokSaghyzRoot = корень кок-сагыза
    .desc = Бледный узловатый корень. Если сломать, выступает белый клейкий сок. Чтобы добыть его, корни мелют в измельчителе.
ent-DystopiaCrackingUnit = крекинг-установка
    .desc = Реактор с засыпкой глинозёма над электропечью. Мазут и дизель расщепляет на бензин и сжиженные газы, а спирт по Лебедеву превращает в бутадиен. Глинозём закладывают внутрь, понемногу расходуется. Всё готовое идёт смесью в бак продукции.
ent-DystopiaPolymerReactor = реактор полимеризации
    .desc = Автоклав под давлением, внутри мешалка. Из этилена и пропилена выходят листы пластика, из бутадиена — сырой каучук.
ent-DystopiaVulcanizer = вулканизационный пресс
    .desc = Пресс с горячими плитами. Закладывают каучук, серу и сажу, а выходят листы резины.
ent-DystopiaChemUnit = химическая установка
    .desc = Реактор с нагревом, охлаждением и рядом дозирующих насосов. Что ни залей в буфер, там не смешивается. Выберите, что производить, и установка возьмёт только нужные вещества в нужных пропорциях, а остальное не тронет. Готовое собирается в отдельный бак.
ent-DystopiaSolutionCrackingProduct = бак продукции
    .desc = { "" }
ent-DystopiaSolutionChemUnitOutput = бак продукции
    .desc = { "" }
