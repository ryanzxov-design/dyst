dystopia-reactor-ui-xenon = Xenon: { $xenon }%
dystopia-reactor-ui-xenon-tip = Xenon poisoning: after power drops xenon chokes the reaction (the iodine pit), builds up over tens of minutes of running, is worst about 8 minutes after shutdown and is gone in 30–40.
dystopia-reactor-ui-map = Core map
dystopia-reactor-ui-zoom-out = Zoom out
dystopia-reactor-ui-zoom-in = Zoom in
dystopia-reactor-ui-legend = North up; click to pick a column. Dark blue: empty fuel channels, loaded ones are coloured by temperature; grey: graphite; light blue: steam-water; red bar: control rods (bar length is depth).
dystopia-reactor-ui-selected-header = No column selected
dystopia-reactor-ui-select-hint = Click a column on the map.
