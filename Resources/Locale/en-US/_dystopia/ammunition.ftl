# Dystopia: ammunition types. Prototypes: _Dystopia/Entities/Objects/Weapons/ammunition.yml

ent-BulletPistolJHP = bullet (.35 auto JHP)
ent-CartridgePistolJHP = cartridge (.35 auto JHP)
    .desc = A .35 auto cartridge with a jacketed hollow point. The bullet mushrooms on impact and leaves a nasty wound, but body armor stops it cold.
ent-MagazineBoxPistolJHP = ammunition box (.35 auto JHP)
    .desc = A cardboard box of .35 auto hollow point rounds.
ent-BulletPistolAP = bullet (.35 auto AP)
ent-CartridgePistolAP = cartridge (.35 auto AP)
    .desc = A .35 auto cartridge with a hardened steel core under the jacket. It gets through vests that would catch a regular bullet, at the cost of a cleaner wound.
ent-MagazineBoxPistolAP = ammunition box (.35 auto AP)
    .desc = A cardboard box of .35 auto armor-piercing rounds.
