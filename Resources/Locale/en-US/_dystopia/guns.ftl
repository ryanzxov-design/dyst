# Dystopia: weapons ported from Backmen (github.com/Rxup/space-station-14). Prototypes: _Dystopia/Entities/Objects/Weapons/Guns/*.yml

ent-DystopiaWeaponPistolPM = PM
    .desc = The Makarov pistol: compact, reliable and familiar to everyone. Feeds from 8-round 9x18mm magazines.
ent-DystopiaWeaponPistolDesertEagle = Desert Eagle
    .desc = A heavy self-loading pistol in .50 AE. The recoil is brutal, but one hit is usually enough. Feeds from 7-round magazines.
ent-DystopiaWeaponSMGMP5 = MP5
    .desc = A classic 9x19mm submachine gun: accurate, controllable, with 30-round magazines.
ent-DystopiaWeaponSMGMP5Tactical = MP5 (tactical)
    .desc = An MP5 with a tactical kit: flashlight and laser sight.
ent-DystopiaWeaponSMGMP7 = MP7
    .desc = A compact 4.6x30mm personal defense weapon. The small pointed bullet goes through light vests well. 40-round magazines.
ent-DystopiaWeaponSMGVector = Vector
    .desc = A .45 ACP submachine gun with an unusual recoil mitigation system and a very high rate of fire. 25-round magazines.
ent-DystopiaWeaponSMGVectorTactical = Vector (tactical)
    .desc = A Vector with a suppressor and tactical kit.
ent-DystopiaWeaponSMGSkorpion = Skorpion vz.61
    .desc = A tiny .32 ACP machine pistol that fits in a pocket. 20-round magazines.
ent-DystopiaWeaponSMGMP38 = MP-38
    .desc = An old 9x19mm submachine gun with a modest rate of fire. 32-round magazines.
ent-DystopiaWeaponSMGUzi = Uzi
    .desc = A cheap, indestructible 9x19mm submachine gun. The 32-round magazine goes in the grip.
ent-DystopiaWeaponSMGPPSh = PPSh-41
    .desc = The 'Papasha': a 7.62x25mm submachine gun with a 71-round drum and a furious rate of fire.
ent-DystopiaWeaponSMGP90 = P90
    .desc = A compact 5.7x28mm personal defense weapon with a 50-round magazine on top of the receiver.
ent-DystopiaWeaponSMGP90Tactical = P90 (tactical)
    .desc = A P90 with a suppressor and tactical kit.
ent-DystopiaWeaponSMGVityaz = Vityaz SMG
    .desc = A 9x19mm submachine gun built on the Kalashnikov platform. 30-round magazines.
ent-DystopiaWeaponRifleAKS74U = AKS-74U
    .desc = A shortened 5.45x39mm carbine with a folding stock. 30-round magazines.
ent-DystopiaWeaponRifleAKS74UTactical = AKS-74U (tactical)
    .desc = An AKS-74U with a suppressor and tactical kit.
ent-DystopiaWeaponRifleAKM = AKM
    .desc = The modernized Kalashnikov rifle in 7.62x39mm with a fixed stock. 30-round magazines.
ent-DystopiaWeaponRifleAKMSTactical = AKMS (tactical)
    .desc = An AKMS with a suppressor and tactical kit.
ent-DystopiaWeaponRifleAR18 = AR-18
    .desc = A simple, cheap 5.56x45mm assault rifle. Takes 30-round STANAG magazines.
ent-DystopiaWeaponRifleG36 = G36
    .desc = A polymer-bodied 5.56x45mm assault rifle. Translucent 30-round magazines.
ent-DystopiaWeaponRifleG36Tactical = G36 (tactical)
    .desc = A G36 with a flashlight and laser sight.
ent-DystopiaWeaponRifleM16A4 = M16A4
    .desc = A long-barreled 5.56x45mm assault rifle, accurate at range. Takes 30-round STANAG magazines.
ent-DystopiaWeaponRifleFAMAS = FAMAS
    .desc = A 5.56x45mm bullpup assault rifle with a fast burst mode. 25-round magazines.
ent-DystopiaWeaponRifleAUG = AUG
    .desc = A 5.56x45mm bullpup assault rifle with a built-in optical sight. 30-round magazines.
ent-DystopiaWeaponRifleSTG44 = STG 44
    .desc = The first mass-produced assault rifle, chambered in 7.92x33mm Kurz. 30-round magazines.
ent-DystopiaWeaponSniperSVD = SVD
    .desc = The Dragunov sniper rifle in 7.62x54mmR. Self-loading, with 10-round magazines.
ent-DystopiaWeaponSniperGarand = M1 Garand
    .desc = A self-loading .30-06 rifle. Loads from 8-round en-bloc clips; the empty clip ejects with a famous ping.
ent-DystopiaWeaponSniperRemington700 = Remington 700
    .desc = A bolt-action hunting rifle in 7.62x51mm. Internal 4-round magazine.
ent-DystopiaWeaponSniperPTRD = PTRD
    .desc = A single-shot 14.5x114mm anti-tank rifle. Long, heavy and able to punch through almost anything.
ent-DystopiaWeaponShotgunXM1014 = XM1014
    .desc = A semi-automatic 12 gauge combat shotgun. 7-round tube magazine.
ent-DystopiaWeaponShotgunXM1014Tactical = XM1014 (tactical)
    .desc = An XM1014 with a flashlight and laser sight.
ent-DystopiaWeaponShotgunSPAS12 = SPAS-12
    .desc = A pump-action 12 gauge shotgun. 8-round tube magazine.
ent-DystopiaWeaponShotgunAA12 = AA-12
    .desc = A fully automatic 12 gauge shotgun fed from a 20-round drum.
ent-DystopiaWeaponMachineGunRPD = RPD
    .desc = The Degtyaryov light machine gun in 7.62x39mm, fed from a 100-round belt drum.
ent-DystopiaWeaponMachineGunMG42 = MG-42
    .desc = A 7.92x57mm general-purpose machine gun with a huge rate of fire. 50-round belt drum.
ent-DystopiaWeaponMachineGunM2 = M2 'Ma Deuce'
    .desc = A 12.7x99mm heavy machine gun. Carrying it is an ordeal, firing it even more so. 100-round belt box.
