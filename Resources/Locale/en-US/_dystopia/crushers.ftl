# Dystopia: ore crushers.

dystopia-crusher-not-crushable = The crusher won't take { THE($item) }.
dystopia-crusher-full = The crusher is full of ore.
dystopia-crusher-loaded = You load { THE($item) } into the crusher ({ $loaded } of { $capacity }).
dystopia-crusher-crank-verb = Turn crank
dystopia-crusher-eject-verb = Empty out ore
dystopia-crusher-ejected = You empty the ore out of the crusher.
dystopia-crusher-not-anchored = The crusher is loose. Bolt it to the floor with a wrench.
dystopia-crusher-empty = There is no ore in the crusher.
dystopia-crusher-examine-load = Ore inside: { $loaded } of { $capacity } chunks.
dystopia-crusher-examine-cycle = Crushes { $ores } { $ores ->
    [one] chunk
   *[other] chunks
} per { $seconds } s cycle; each chunk gives two handfuls.
dystopia-crusher-examine-loose = [color=#d0a040]Not bolted to the floor.[/color]
dystopia-crusher-examine-unpowered = [color=#d05050]No power.[/color]
